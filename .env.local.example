# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real secrets.
#
# Used by: utilities/VUSiteTitlePlayoutURLs.js, utilities/CheckTitlePolicies.js
# (VUSiteTitleDashboard.js reads only local state and needs none of this)

# Fabric access - your own account's private key and target network config.
PRIVATE_KEY=
FABRIC_CONFIG_URL=https://main.net955305.contentfabric.io/config

# Tenant / marketplace used to resolve NFT templates and permissions.
TENANT_ID=
MARKETPLACE=

# Comparison site checked for title overlap (VU Affiliate Master Site - Meta PROD).
COMPARE_SITE_OBJECT_ID=iq__3S59EtLbz44nSHfse1U5yLxVKVpy

# CSAT signed-token authority used to mint EST/TVOD user tokens below.
# These already have working defaults baked into VUSiteTitlePlayoutURLs.js - only
# override if you need a different authority/nonce/expiry.
AUTHORITY_URL=https://host-76-74-28-232.contentfabric.io
NONCE=test_nonce__
EXP=86400

# Two independent CSAT test accounts - one per offer type - each producing its own
# signed playout token and wallet address.
EST_EMAIL=
EST_PASSWORD=
TVOD_EMAIL=
TVOD_PASSWORD=
